generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  BUSINESS_OWNER
  MANAGER
  RECEPTIONIST
  VIEWER
}

enum DoctorStatus {
  PENDING
  APPROVED
  SUSPENDED
  REFUSED
}

enum HospitalStatus {
  PENDING
  APPROVED
  SUSPENDED
  REFUSED
}

enum DayOfWeek {
  SATURDAY
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  password     String
  isVerified   Boolean   @default(false)
  otp          String?
  otpExpiry    DateTime?
  refreshToken String?
  
  // Timestamps
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

model ChatSession {
  id           String   @id @default(uuid())
  phoneNumber  String   @unique
  targetType   String?
  targetId     String?
  targetName   String?
  lastFlow     String?
  lastStep     String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model Doctor {
  id                  String         @id @default(uuid())
  name                String
  degree              String
  speciality          String
  tagline             String?
  bio                 String?
  phone               String
  whatsappNumber      String?
  whatsappAccessToken String?
  whatsappId          String?
  email               String?        @unique
  username            String         @unique
  templateName        String         @default("template_a")
  startedYear         Int?
  status              DoctorStatus   @default(PENDING)
  
  chambers            Chamber[]
  schedules           DoctorSchedule[]

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model Hospital {
  id                  String         @id @default(uuid())
  name                String
  slug                String         @unique
  templateName        String         @default("template_a")
  address             String?
  phone               String?
  establishedYear     Int?
  status              HospitalStatus @default(PENDING)

  chambers            Chamber[]
  schedules           DoctorSchedule[]

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model Chamber {
  id           String    @id @default(uuid())
  doctorId     String?
  doctor       Doctor?   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  
  hospitalId   String?
  hospital     Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  
  chamberName  String?
  addressLine  String
  thana        String
  district     String
  division     String
  
  latitude     Float?
  longitude    Float?

  // চেম্বার ভেদে নতুন ও পুরনো রোগীর ভিজিট ফি
  newPatientFee     Float    @default(0) // নতুন রোগীর ফি (যেমন: ৭০০)
  oldPatientFee     Float    @default(0) // পুরনো/রিভিজিট রোগীর ফি (যেমন: ৬০০)

  // Relations
  schedules    DoctorSchedule[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model DoctorSchedule {
  id         String    @id @default(uuid())
  doctorId   String
  doctor     Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  
  hospitalId String?
  hospital   Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  
  chamberId  String?
  chamber    Chamber?  @relation(fields: [chamberId], references: [id], onDelete: SetNull)
  
  dayOfWeek  DayOfWeek
  startTime  String
  endTime    String

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}