generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum Role {
  SUPER_ADMIN
  DOCTOR
  DOCTOR_STAFF
  BUSINESS_OWNER
  HOSPITAL_STAFF
  HOSPITAL
}

enum DoctorStatus {
  PENDING
  APPROVED
  SUSPENDED
  REFUSED
}

enum Gender {
  MALE
  FEMALE
}

enum HospitalStatus {
  PENDING
  APPROVED
  SUSPENDED
  REFUSED
}

enum DayOfWeek {
  SATURDAY
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

enum BlogAuthorType {
  DOCTOR
  HOSPITAL
  SUPER_ADMIN
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  password     String
  role         Role      @default(DOCTOR)
  isVerified   Boolean   @default(false)
  otp          String?
  otpExpiry    DateTime?
  refreshToken String?
  
  // Timestamps
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // রোলের উপর ভিত্তি করে সংশ্লিষ্ট প্রোফাইলগুলোর সাথে অপশনাল ওয়ান-টু-ওয়ান রিলেশন
  doctorProfile     Doctor?
  hospitalProfile   Hospital?
  superAdminProfile SuperAdminProfile?

  @@map("users")
}

// সুপার এডমিন প্রোফাইল টেবিল (মেইন User টেবিলের সাথে কানেক্টেড)
model SuperAdminProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name        String?
  permissions String[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("super_admin_profiles")
}

model ChatSession {
  id          String   @id @default(uuid())
  phoneNumber String   @unique
  targetType  String?
  targetId    String?
  targetName  String?
  lastFlow    String?
  lastStep    String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("chat_sessions")
}

model Doctor {
  id                  String         @id @default(uuid())
  
  // মেইন User টেবিলের সাথে লিংক করার জন্য userId (অপশনাল রাখা হয়েছে যাতে প্রয়োজনে স্বাধীনভাবে এন্ট্রি হতে পারে)
  userId              String?        @unique
  user                User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  name                String
  degree              String
  speciality          String
  tagline             String?
  bio                 String?
  phone               String
  whatsappNumber      String?
  whatsappAccessToken String?
  whatsappId          String?
  email               String?        @unique
  username            String         @unique
  templateName        String         @default("template_a")
  profilePicture      String?
  gender              Gender?
  startedYear         Int?
  status              DoctorStatus   @default(PENDING)
  
  chambers            Chamber[]
  schedules           DoctorSchedule[]
  pendingAppointments PendingAppointment[]
  information         DoctorInformation?
  blogs               Blog[]

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@map("doctors")
}

model Hospital {
  id              String         @id @default(uuid())
  
  // মেইন User টেবিলের সাথে লিংক করার জন্য userId
  userId          String?        @unique
  user            User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  name            String
  slug            String         @unique
  templateName    String         @default("template_a")
  address         String?
  phone           String?
  establishedYear Int?
  status          HospitalStatus @default(PENDING)

  chambers        Chamber[]
  schedules       DoctorSchedule[]
  blogs           Blog[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("hospitals")
}

model Chamber {
  id           String    @id @default(uuid())
  doctorId     String?
  doctor       Doctor?   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  
  hospitalId   String?
  hospital     Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  
  chamberName  String?
  addressLine  String
  thana        String
  district     String
  division     String
  
  latitude     Float?
  longitude    Float?

  // চেম্বার ভেদে নতুন ও পুরনো রোগীর ভিজিট ফি
  newPatientFee Float    @default(0)
  oldPatientFee Float    @default(0)

  // Relations
  schedules    DoctorSchedule[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("chambers")
}

model DoctorSchedule {
  id         String    @id @default(uuid())
  doctorId   String
  doctor     Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  
  hospitalId String?
  hospital   Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  
  chamberId  String?
  chamber    Chamber?  @relation(fields: [chamberId], references: [id], onDelete: SetNull)
  
  dayOfWeek  DayOfWeek
  startTime  String
  endTime    String

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("doctor_schedules")
}

model PendingAppointment {
  id              String   @id @default(uuid())
  phoneNumber     String   // sender WhatsApp number (session owner)
  doctorId        String
  doctor          Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  doctorName      String?

  problem         String   // 'আপনার সমস্যা কী?' — saved to memory
  appointmentDate DateTime // today or tomorrow (running day only)
  dayLabel        String?  // e.g. "আজকে — বৃহস্পতিবার, 11 Sep"

  chamberId       String?  // selected chamber
  chamberName     String?

  patientName     String
  patientAge      Int?
  patientWeight   Float?
  patientArea     String?  // user's area
  contactPhone    String   // typed number or sender number via button

  status          String   @default("PENDING")

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("pending_appointments")
}

// ডাক্তারের পাবলিক ওয়েবসাইটের ডাইনামিক সেকশনগুলোর জন্য অতিরিক্ত তথ্য।
// Doctor এর সাথে one-to-one রিলেশন (doctorId unique)।
// - expertise: [{ icon, service, service_details }] → "আমি যেসব চিকিৎসা সক্রিয়ভাবে করি"
// - timeline:  [{ year, title }] → "যোগ্যতা ও অভিজ্ঞতা / একটি দীর্ঘ পথের প্রতিফলন"
// দুটোই Json array — অবজেক্ট সংখ্যা নির্দিষ্ট নয়, যত খুশি যোগ করা যাবে।
model DoctorInformation {
  id        String   @id @default(uuid())

  doctorId  String   @unique
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  expertise Json     @default("[]")
  timeline  Json     @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("doctor_informations")
}

// ব্লগ — ডাক্তার, হাসপাতাল ও সুপার-অ্যাডমিন তিনজনই লিখতে পারেন।
// - DOCTOR লিখলে doctorId বসে, HOSPITAL লিখলে hospitalId বসে,
//   SUPER_ADMIN লিখলে authorUserId বসে (প্রয়োজনে doctorId/hospitalId-ও দিতে পারেন)।
// - পাবলিক সাইটে শুধু PUBLISHED ব্লগ দেখায়; ডাক্তারের প্রোফাইল পেজে
//   তার নিজের ব্লগগুলো "স্বাস্থ্য নিয়ে কিছু জরুরি কথা" সেকশনে আসে।
model Blog {
  id            String          @id @default(uuid())
  slug          String          @unique
  title         String
  excerpt       String?
  content       String
  coverImage    String?
  coverGradient String          @default("from-emerald-500 to-teal-700")
  coverSymbol   String          @default("✿")
  category      String          @default("স্বাস্থ্য টিপস")
  tags          String[]        @default([])

  authorType    BlogAuthorType  @default(DOCTOR)
  authorName    String?
  authorUserId  String?

  doctorId      String?
  doctor        Doctor?         @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  hospitalId    String?
  hospital      Hospital?       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  status        BlogStatus      @default(DRAFT)
  publishedAt   DateTime?
  views         Int             @default(0)

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status, publishedAt])
  @@index([doctorId, status])
  @@index([hospitalId, status])
  @@map("blogs")
}